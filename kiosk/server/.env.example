# ── KioskFleet server configuration ──────────────────────────────
# Copy to ".env" and fill in real values. NEVER commit the real .env.

# HTTP port the server listens on
PORT=8080

# Public base URL of this server (used in enrollment QR / device config).
# In production this MUST be an https:// address behind TLS.
PUBLIC_URL=http://localhost:8080

# Path prefix this server is served under. NetFree blocks *.up.railway.app, so
# users reach the platform only through more30.com/<name>; the portal proxies
# more30.com/kiosk/* here and the server owns the prefix.
# Empty = served at the root (local dev, direct Railway URL).
BASE_PATH=

# 'production' opens search indexing. Anything else serves a Disallow robots.txt.
KIOSK_ENV=development

# Secret used to sign dashboard JWTs. Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# First super-admin created on first run (see src/seed.js).
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=change-this-now

# Path to the SQLite database file.
DB_PATH=./data/kioskfleet.db

# Minutes without a heartbeat before a device is considered "offline".
OFFLINE_AFTER_MINUTES=3
