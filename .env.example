# ============================================================
# kesef-platform — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# Each new variable added to the code MUST be documented here.
# ============================================================

# --- Supabase (Postgres + Auth + RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server/jobs only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct connection string for migrations (packages/db).
DATABASE_URL=

# --- Cloudflare R2 (immutable source-document archive) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kesef-sources

# --- Anthropic API (agent narration + document extraction) ---
ANTHROPIC_API_KEY=

# --- Analytics (loaded only after cookie consent) ---
NEXT_PUBLIC_ANALYTICS_ID=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
